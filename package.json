{
  "name": "magpie-computer-use",
  "version": "0.5.0",
  "description": "Computer Use extension for magpie with an automatically registered ten-tool MCP",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./server": "./index.mjs"
  },
  "bin": {
    "magpie-computer-use": "./bin/magpie-computer-use.mjs"
  },
  "files": [
    "index.mjs",
    "assets",
    "src",
    "bin",
    "scripts",
    "vendor",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "doctor": "node bin/magpie-computer-use.mjs doctor",
    "mcp": "node bin/magpie-computer-use.mjs mcp",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "verify-runtime": "node bin/magpie-computer-use.mjs prepare",
    "fixture:gui": "node scripts/gui-fixture.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "smol-toml": "1.9.1"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "computer-use",
    "mcp",
    "lcu",
    "opencode",
    "opencode-plugin",
    "codex",
    "macos"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wbb6517/magpie-computer-use.git"
  },
  "homepage": "https://github.com/wbb6517/magpie-computer-use#readme",
  "bugs": {
    "url": "https://github.com/wbb6517/magpie-computer-use/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "kind": "tools"
  }
}
