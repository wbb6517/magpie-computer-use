{
  "name": "magpie-computer-use",
  "version": "0.4.0",
  "description": "Computer Use extension for magpie with an automatically registered ten-tool MCP",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "bin": {
    "magpie-computer-use": "./bin/magpie-computer-use.mjs"
  },
  "files": [
    "index.mjs",
    "src",
    "bin",
    "page",
    "scripts",
    "vendor",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "doctor": "node bin/magpie-computer-use.mjs doctor",
    "mcp": "node bin/magpie-computer-use.mjs mcp",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "verify-runtime": "node bin/magpie-computer-use.mjs prepare",
    "fixture:gui": "node scripts/gui-fixture.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "computer-use",
    "mcp",
    "lcu"
  ],
  "license": "MIT",
  "magpie": {
    "page": {
      "title": "Computer Use",
      "file": "page/index.html",
      "icon": "page/icon.svg"
    }
  }
}
